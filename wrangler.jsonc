{
  // Cloudflare Workers：静态资源 + /api/news + /api/sync
  "name": "staticpages",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // ---- 多端同步 ----
  // D1：存版本号与登录限流
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yakult-sync",
      "database_id": "4f7c749f-ab7b-47d0-8b90-7da00ed38fb0"
    }
  ],

  // KV：存快照、图片、书籍正文（不需要绑定支付方式）
  // 若以后开通 R2，可换成 r2_buckets（绑定名 BLOBS），src/api/storage.js 会自动优先用 R2
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "15f44683035b440bb602294d590113fe"
    }
  ]
}
