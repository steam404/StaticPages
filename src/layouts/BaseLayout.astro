---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  isPost?: boolean;
}

const {
  title,
  description = '记录学习、思考与折腾的地方。',
  isPost = false,
} = Astro.props;

const siteName = '养乐多的主页';
const pageTitle = isPost ? `${title} · ${siteName}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const path = Astro.url.pathname;
const links = [
  { href: '/', label: '文章' },
  { href: '/eat/', label: '吃什么' },
  { href: '/read/', label: '看什么' },
  { href: '/play/', label: '玩什么' },
  { href: '/fortune/', label: '运势' },
  { href: '/about/', label: '关于' },
];
const active = href => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isPost ? 'article' : 'website'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{siteName}</a>
      <nav>
        {
          links.map(link => (
            <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <button id="sync-btn" class="sync-btn" data-state="out" title="同步">
        <span class="dot" aria-hidden="true"></span>
        同步
      </button>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()}
        {siteName} · 用 <a href="https://astro.build" rel="noopener">Astro</a> 构建
      </p>
    </footer>

    <!-- 像素地面 + 跑步马里奥 -->
    <div class="pixel-ground">
      <img src="/sprites/mario_run.gif" class="mario-run" alt="" aria-hidden="true" />
    </div>

    <dialog id="sync-dialog"><div class="modal-inner" id="sync-app"></div></dialog>
    <dialog id="sync-conflict"></dialog>

    <script>
      import '../scripts/sync.js';
    </script>
  </body>
</html>
