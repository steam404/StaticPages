---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts, formatDate } from '../lib/posts';
---

<BaseLayout title="养乐多的主页" description="养乐多的主页：吃什么、在看什么，还有一些随手写的字。">
  <section class="intro">
    <h1>你好，我是养乐多</h1>
    <p>这里记我做的菜、吃过的饭，和一点技术笔记。</p>
  </section>

  <div class="entries">
    <a class="entry" href="/eat/">
      <span class="entry-emoji">🥢</span>
      <span class="entry-text">
        <strong>养乐多在吃什么</strong>
        <small>记录每天的菜、热量和营养</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>

    <a class="entry" href="/read/">
      <span class="entry-emoji">📖</span>
      <span class="entry-text">
        <strong>养乐多在看什么</strong>
        <small>全球新闻与书籍</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>

    <a class="entry" href="/play/">
      <span class="entry-emoji">🎮</span>
      <span class="entry-text">
        <strong>养乐多在玩什么</strong>
        <small>玩过的游戏，带星级和 Steam 链接</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>

    <a class="entry" href="/fortune/">
      <span class="entry-emoji">🎋</span>
      <span class="entry-text">
        <strong>养乐多今天运势如何</strong>
        <small>摇一支签，看看今天 — 纯属娱乐</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>
  </div>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={post.url}>
            <h2>{post.data.title}</h2>
            {post.data.description && <p>{post.data.description}</p>}
          </a>
          <div class="meta">
            <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            {(post.data.tags ?? []).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>

  {
    posts.length === 0 && (
      <p>
        还没有文章，去 <code>src/posts/</code> 里新建一个 .md 文件吧。
      </p>
    )
  }
</BaseLayout>

<style>
  .entries {
    display: grid;
    gap: 0.7rem;
    margin: 1.8rem 0 0.5rem;
  }

  @media (min-width: 560px) {
    .entries {
      grid-template-columns: 1fr 1fr;
    }
  }

  .entry {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
  }

  .entry:hover {
    text-decoration: none;
  }

  .entry-emoji {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    font-size: 1.3rem;
    line-height: 1;
  }

  .entry-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .entry-text strong {
    font-size: 1rem;
    line-height: 1.4;
  }

  .entry-text small {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .entry-arrow {
    margin-left: auto;
    flex: none;
    color: var(--accent);
    font-size: 1.05rem;
    transition: transform 0.16s var(--ease);
  }

  .entry:hover .entry-arrow {
    transform: translateX(3px);
  }
</style>
