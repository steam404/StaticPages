---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { posts, pagePosts, totalPages } from '../lib/posts';

const items = pagePosts(1);
const hasNext = totalPages > 1;
---

<BaseLayout title="养乐多的主页" description="养乐多的主页：吃什么、在看什么，还有一些随手写的字。">
  <section class="intro">
    <h1>欢迎来到养乐多的主页</h1>
    <p>关于美食、游戏、动漫和生活的个人博客</p>
  </section>

  <div class="entries">
    <a class="entry" data-color="red" href="/eat/">
      <span class="entry-sprite"><img src="/sprites/mushroom.png" alt="蘑菇" /></span>
      <span class="entry-text">
        <strong>吃什么</strong>
        <small>随机抽取今天吃什么</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>

    <a class="entry" data-color="orange" href="/read/">
      <span class="entry-sprite"><img src="/sprites/qblock.png" alt="问号方块" /></span>
      <span class="entry-text">
        <strong>看什么</strong>
        <small>动漫与影视观后感</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>

    <a class="entry" data-color="yellow" href="/play/">
      <span class="entry-sprite"><img src="/sprites/star.png" alt="无敌星" /></span>
      <span class="entry-text">
        <strong>玩什么</strong>
        <small>游戏体验与测评</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>

    <a class="entry" data-color="green" href="/fortune/">
      <span class="entry-sprite"><img src="/sprites/1up.png" alt="绿蘑菇" /></span>
      <span class="entry-text">
        <strong>今日运势</strong>
        <small>摇一支签，看看今天</small>
      </span>
      <span class="entry-arrow">→</span>
    </a>
  </div>

  <PostList items={items} />

  {
    totalPages > 1 && (
      <nav class="pager" aria-label="分页">
        <span class="pager-info">
          第 1 / {totalPages} 页
        </span>
        <a class="btn-ghost" href="/page/2/">
          下一页 →
        </a>
      </nav>
    )
  }

  {
    posts.length === 0 && (
      <p>
        还没有文章，去 <code>src/posts/</code> 里新建一个 .md 文件吧。
      </p>
    )
  }
</BaseLayout>

<style>
  /* 首页入口卡片样式已在 global.css 中定义 */
</style>
