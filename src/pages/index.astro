---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts, formatDate } from '../lib/posts';
---

<BaseLayout title="养乐多的博客" description="养乐多写字的地方：做饭、吃饭、以及一些没想明白的问题。">
  <section class="intro">
    <h1>你好，我是养乐多</h1>
    <p>这里记我做的菜、吃过的饭，和一点技术笔记。</p>
  </section>

  <a class="eat-entry" href="/eat/">
    <span class="eat-emoji">🍚</span>
    <span class="eat-text">
      <strong>养乐多在吃什么</strong>
      <small>记录每天的菜、热量和营养</small>
    </span>
    <span class="eat-arrow">→</span>
  </a>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={post.url}>
            <h2>{post.data.title}</h2>
            {post.data.description && <p>{post.data.description}</p>}
          </a>
          <div class="meta">
            <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            {(post.data.tags ?? []).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>

  {
    posts.length === 0 && (
      <p>
        还没有文章，去 <code>src/posts/</code> 里新建一个 .md 文件吧。
      </p>
    )
  }
</BaseLayout>

<style>
  .eat-entry {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.6rem 0 0.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .eat-entry:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .eat-emoji {
    font-size: 1.6rem;
    line-height: 1;
  }

  .eat-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .eat-text strong {
    font-size: 1rem;
  }

  .eat-text small {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .eat-arrow {
    margin-left: auto;
    color: var(--accent);
    font-size: 1.1rem;
  }
</style>
