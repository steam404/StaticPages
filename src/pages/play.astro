---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GAMES } from '../data/games.js';

const games = [...GAMES].sort((a, b) => b.rating - a.rating);

/** 5 颗星，支持半星 */
const stars = rating => {
  let out = '';
  for (let i = 1; i <= 5; i++) {
    if (rating >= i) out += '<i class="on">★</i>';
    else if (rating >= i - 0.5) out += '<i class="half">★</i>';
    else out += '<i class="off">★</i>';
  }
  return out;
};

const fmt = rating => (Number.isInteger(rating) ? `${rating}.0` : String(rating));
---

<BaseLayout title="养乐多在玩什么" description="玩过并且愿意推荐的游戏，带星级和 Steam 链接。">
  <div class="play">
    <header class="play-head">
      <h1>养乐多在玩什么</h1>
      <p class="play-sub">玩过、而且愿意推荐的。按星级排。</p>
    </header>

    <ul class="game-list">
      {
        games.map(game => (
          <li class="game">
            <div class="cover" aria-hidden="true">
              <span class="letter">{game.title.slice(0, 1)}</span>
              <img
                src={game.cover}
                alt=""
                loading="lazy"
                referrerpolicy="no-referrer"
                onerror="this.remove()"
              />
            </div>

            <div class="game-main">
              <div class="game-title">
                <h2>{game.title}</h2>
                <span class="genre">{game.genre}</span>
              </div>

              <p class="en">{game.titleEn}</p>

              <div class="rating" aria-label={`评分 ${fmt(game.rating)} 星，满分 5 星`}>
                <span class="stars" set:html={stars(game.rating)} />
                <span class="score">{fmt(game.rating)}</span>
              </div>

              <p class="reason">{game.reason}</p>

              <a class="steam" href={game.steam} target="_blank" rel="noopener noreferrer">
                Steam 商店 ↗
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <nav class="game-pager" aria-label="分页"></nav>

    <section class="bubbles">
      <div class="bubbles-head">
        <h2>留言气泡</h2>
      </div>

      <div class="bubble-layer" id="bubble-layer" aria-hidden="true"></div>
      <div class="bubble-static" id="bubble-static"></div>
      <p class="bubble-empty" id="bubble-empty" hidden>还没有人留言，登录后可以留第一句。</p>

      <form class="bubble-form" id="bubble-form" hidden>
        <textarea id="bubble-body" maxlength="120" rows="2" placeholder="留一句…"></textarea>
        <div class="bubble-actions">
          <span class="bubble-hint" id="bubble-hint"></span>
          <button class="btn-primary" type="submit">发一条</button>
        </div>
      </form>

      <p class="bubble-login" id="bubble-login" hidden>
        登录后才能留言
        <button class="btn-ghost" type="button" data-bubble="login">去登录</button>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  const PER_PAGE = 5;
  const list = document.querySelector('.game-list');
  const pager = document.querySelector('.game-pager');

  if (list && pager) {
    const items = Array.from(list.children);
    const pages = Math.max(1, Math.ceil(items.length / PER_PAGE));
    let page = 1;

    const paint = () => {
      items.forEach((el, i) => {
        el.style.display = Math.floor(i / PER_PAGE) + 1 === page ? '' : 'none';
      });

      if (pages <= 1) {
        pager.innerHTML = '';
        return;
      }

      pager.innerHTML = `
        <button class="btn-ghost" data-page="${page - 1}" ${page === 1 ? 'disabled' : ''}>← 上一页</button>
        <span class="pager-info">${page} / ${pages}</span>
        <button class="btn-ghost" data-page="${page + 1}" ${page === pages ? 'disabled' : ''}>下一页 →</button>
      `;
    };

    pager.addEventListener('click', e => {
      const btn = e.target.closest('button[data-page]');
      if (!btn) return;
      page = Number(btn.dataset.page);
      paint();
      list.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    paint();
  }
</script>

<script>
  const layer = document.getElementById('bubble-layer');
  const staticBox = document.getElementById('bubble-static');
  const emptyHint = document.getElementById('bubble-empty');
  const bubbleForm = document.getElementById('bubble-form');
  const bubbleLogin = document.getElementById('bubble-login');
  const bubbleHint = document.getElementById('bubble-hint');
  const bodyInput = document.getElementById('bubble-body');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MAX_ON_SCREEN = 4;

  let pool = [];
  let cursor = 0;

  function bubbleEl(item) {
    const el = document.createElement('div');
    el.className = 'bubble';

    const p = document.createElement('p');
    p.textContent = item.body;
    el.appendChild(p);

    if (item.author) {
      const by = document.createElement('span');
      by.className = 'bubble-by';
      by.textContent = '— ' + item.author;
      el.appendChild(by);
    }
    return el;
  }

  function renderStatic() {
    if (!staticBox) return;
    if (!pool.length) {
      staticBox.innerHTML = '<p class="bubble-empty">还没有人留言。</p>';
      return;
    }
    staticBox.replaceChildren(...pool.slice(0, 4).map(bubbleEl));
  }

  async function fetchPool() {
    try {
      const res = await fetch('/api/bubbles?limit=20', { cache: 'no-store', credentials: 'same-origin' });
      const data = await res.json();
      pool = (data.items || []).filter(b => b && b.body);
    } catch {
      pool = [];
    }

    if (emptyHint) emptyHint.hidden = pool.length > 0;
    if (reduceMotion) renderStatic();
  }

  function randomSpot() {
    const w = layer.clientWidth || window.innerWidth;
    const h = layer.clientHeight || window.innerHeight;

    // 留出气泡自身宽度
    const x = 16 + Math.random() * Math.max(16, w - 260);

    // 不让气泡压住下面的留言框
    let maxY = h * 0.6;
    if (bubbleForm && !bubbleForm.hidden) {
      const rect = bubbleForm.getBoundingClientRect();
      if (rect.top > 80) maxY = Math.min(maxY, rect.top - 110);
    }

    const y = 70 + Math.random() * Math.max(40, maxY - 70);
    return { x, y };
  }

  function tooClose(x, y) {
    return [...layer.querySelectorAll('.bubble')].some(el => {
      const dx = Math.abs(parseFloat(el.style.left || '0') - x);
      const dy = Math.abs(parseFloat(el.style.top || '0') - y);
      return dx < 190 && dy < 90;
    });
  }

  function spawn() {
    if (!layer || !pool.length) return;
    if (layer.querySelectorAll('.bubble').length >= MAX_ON_SCREEN) return;

    const item = pool[cursor++ % pool.length];
    const el = bubbleEl(item);

    let spot = randomSpot();
    for (let i = 0; i < 6 && tooClose(spot.x, spot.y); i++) spot = randomSpot();

    el.style.left = spot.x + 'px';
    el.style.top = spot.y + 'px';
    layer.appendChild(el);

    requestAnimationFrame(() => el.classList.add('show'));

    const life = 5200 + Math.random() * 2600;
    setTimeout(() => {
      el.classList.remove('show');
      setTimeout(() => el.remove(), 1100);
    }, life);
  }

  async function checkLogin() {
    try {
      const res = await fetch('/api/auth/me', { cache: 'no-store', credentials: 'same-origin' });
      const data = await res.json().catch(() => null);
      const ok = res.ok && data?.ok === true;
      if (bubbleForm) bubbleForm.hidden = !ok;
      if (bubbleLogin) bubbleLogin.hidden = ok;
    } catch {
      if (bubbleForm) bubbleForm.hidden = true;
      if (bubbleLogin) bubbleLogin.hidden = false;
    }
  }

  bubbleForm?.addEventListener('submit', async e => {
    e.preventDefault();
    const body = bodyInput.value.trim();
    if (!body) {
      bubbleHint.textContent = '写点什么再发';
      return;
    }

    bubbleHint.textContent = '发送中…';
    try {
      const res = await fetch('/api/bubbles', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ body }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '发送失败');

      bodyInput.value = '';
      bubbleHint.textContent = '已发送';
      await fetchPool();
      if (!reduceMotion) spawn();
      setTimeout(() => (bubbleHint.textContent = ''), 2000);
    } catch (err) {
      bubbleHint.textContent = err.message;
    }
  });

  document
    .querySelector('[data-bubble="login"]')
    ?.addEventListener('click', () => document.getElementById('sync-btn')?.click());

  (async () => {
    await fetchPool();
    await checkLogin();
    if (reduceMotion) return;

    spawn();
    setInterval(spawn, 3400);
  })();
</script>

<style is:global>
  .play {
    max-width: 44rem;
    margin: 0 auto;
  }

  .play-head h1 {
    margin: 0.2rem 0 0.35rem;
    font-size: 1.6rem;
    letter-spacing: -0.01em;
  }

  .play-sub {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .game-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .game-pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 1.3rem;
    flex-wrap: wrap;
  }

  .game {
    display: flex;
    gap: 0.9rem;
    border: 3px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    padding: 0.85rem;
  }

  .cover {
    position: relative;
    flex: none;
    width: 3.6rem;
    height: 4.8rem;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(150deg, #b4451d, #7a2f14);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .cover .letter {
    position: relative;
    z-index: 0;
  }

  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .game:nth-child(3n + 2) .cover {
    background: linear-gradient(150deg, #3f6ea8, #1f3c60);
  }

  .game:nth-child(3n + 3) .cover {
    background: linear-gradient(150deg, #4a7a52, #24402a);
  }

  .game-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .game-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .game-title h2 {
    margin: 0;
    font-size: 1.02rem;
  }

  .genre {
    font-size: 0.72rem;
    color: var(--muted);
    border: 3px solid var(--border);
    border-radius: 0;
    padding: 0 0.5rem;
    white-space: nowrap;
  }

  .en {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.2rem 0 0.1rem;
  }

  .stars i {
    font-style: normal;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .stars i.on {
    color: #e0a526;
  }

  .stars i.off {
    color: var(--border);
  }

  .stars i.half {
    background: linear-gradient(90deg, #e0a526 50%, var(--border) 50%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .score {
    font-size: 0.78rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .reason {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .steam {
    align-self: flex-start;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    border: 3px solid var(--border);
    border-radius: 0;
    padding: 0.15rem 0.7rem;
  }

  .steam:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  /* ---------- 留言气泡 ---------- */

  .play .bubbles {
    position: relative;
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 2px solid var(--border);
  }

  .play .bubbles-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }

  .play .bubbles-head h2 {
    margin: 0;
    font-size: 1rem;
  }

  /* 随机飘浮层：覆盖整个视口，不挡点击 */
  .play .bubble-layer {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 3;
  }

  .play .bubble {
    position: absolute;
    max-width: min(15rem, 70vw);
    padding: 0.6rem 0.85rem;
    border: 3px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    box-shadow: var(--shadow-md);
    font-size: 0.85rem;
    line-height: 1.65;
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }

  .play .bubble.show {
    opacity: 1;
    transform: none;
  }

  .play .bubble p {
    margin: 0;
  }

  .play .bubble-by {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.72rem;
    color: var(--muted);
    text-align: right;
  }

  /* 减少动效时的静态兜底 */
  .play .bubble-static {
    display: none;
    flex-direction: column;
    gap: 0.6rem;
  }

  .play .bubble-static .bubble {
    position: static;
    max-width: 36rem;
    opacity: 1;
    transform: none;
  }

  .play .bubble-empty {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .play .bubble-layer {
      display: none;
    }

    .play .bubble-static {
      display: flex;
    }
  }

  .play .bubble-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .play .bubble-form textarea {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.6rem;
    border: 3px solid var(--border);
    border-radius: 0;
    background: var(--bg);
    color: var(--fg);
    resize: vertical;
  }

  .play .bubble-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .play .bubble-hint {
    margin-right: auto;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .play .bubble-login {
    margin: 1rem 0 0;
    font-size: 0.84rem;
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .cover {
      width: 2.8rem;
      height: 3.8rem;
      font-size: 1.2rem;
    }
  }
</style>
